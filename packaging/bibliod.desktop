[Desktop Entry]
Version=1.0
Type=Application
Name=BiblioD
GenericName=Gestionnaire de Bibliothèque
Comment=Application de gestion de bibliothèque personnelle et analyse d'auteurs
Exec=/usr/bin/bibliod %U
Icon=bibliod
Terminal=false
